---
/**
 * High-level CV for the home page: one scannable row per role, newest first.
 *
 * This is the summary view — period, role, org, one line, stack chips. The
 * full bullet-by-bullet timeline stays on /about/ (Timeline.astro).
 */
import { getCollection } from 'astro:content';

const KIND_COLOR = {
  venture: 'gold',
  education: 'violet',
  work: 'cyan',
} as const;

const KIND_LABEL = {
  venture: 'Venture',
  education: 'Study',
  work: 'Role',
} as const;

const entries = (await getCollection('experience')).sort((a, b) => b.data.sort - a.data.sort);
---

<ol class="track">
  {
    entries.map((entry) => {
      const color = KIND_COLOR[entry.data.kind];
      return (
        <li class="track__item" style={`--node: var(--c-${color}); --node-wash: var(--c-${color}-wash)`}>
          <div class="track__rail" aria-hidden="true">
            <span class="track__node" />
          </div>

          <div class="track__meta">
            <span class="track__period">{entry.data.period}</span>
            <span class="track__kind">{KIND_LABEL[entry.data.kind]}</span>
          </div>

          <div class="track__body">
            <h3 class="track__role">{entry.data.role}</h3>
            <p class="track__org">
              {entry.data.org}
              {entry.data.location && <span class="track__location"> · {entry.data.location}</span>}
            </p>
            <p class="track__summary">{entry.data.summary}</p>
            {entry.data.tags.length > 0 && (
              <ul class="track__tags">
                {entry.data.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .track {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .track__item {
    display: grid;
    grid-template-columns: 28px 1fr;
    grid-template-areas:
      'rail meta'
      'rail body';
    column-gap: var(--s-3);
    padding-block-end: var(--s-6);
  }

  /* The vertical rail with a pixel node, like a level-select map. */
  .track__rail {
    grid-area: rail;
    position: relative;
    display: flex;
    justify-content: center;
  }

  .track__rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: calc(-1 * var(--s-6));
    inline-size: 3px;
    background: var(--rule);
  }

  .track__item:last-child .track__rail::before {
    bottom: auto;
    block-size: 14px;
  }

  .track__node {
    position: relative;
    inline-size: 15px;
    block-size: 15px;
    margin-block-start: 3px;
    background: var(--node);
    border: 2px solid var(--ink);
  }

  .track__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-2);
  }

  .track__period {
    font-family: var(--font-pixel), monospace;
    font-size: var(--pixel-xs);
    color: var(--node);
    text-transform: uppercase;
  }

  .track__kind {
    font-family: var(--font-mono), monospace;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .track__body {
    grid-area: body;
  }

  .track__role {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .track__org {
    margin-top: 2px;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--ink-muted);
  }

  .track__location {
    color: var(--ink-faint);
    font-weight: 400;
  }

  .track__summary {
    margin-top: var(--s-2);
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: 1.55;
    max-width: 52ch;
  }

  .track__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Wider screens get the period in its own column, so roles line up. */
  @media (min-width: 46rem) {
    .track__item {
      grid-template-columns: 9rem 28px 1fr;
      grid-template-areas: 'meta rail body';
      column-gap: var(--s-4);
    }

    .track__meta {
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
      margin-bottom: 0;
      padding-block-start: 2px;
      text-align: right;
    }
  }
</style>
