---
/**
 * Home hero: character card on one side, the pitch on the other.
 *
 * The name, title line, positioning line and all three buttons must stay
 * visible without scrolling at 1280x800 and 390x844 — tests/smoke.spec.ts
 * asserts it, so keep this block compact when editing.
 */
import { Image } from 'astro:assets';
import profile from '../assets/profile.jpeg';
import { site } from '../data/site';
---

<section class="hero" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__px hero__px--1"></span>
    <span class="hero__px hero__px--2"></span>
    <span class="hero__px hero__px--3"></span>
    <span class="hero__px hero__px--4"></span>
  </div>

  <div class="wrap hero__inner">
    <div class="hero__card">
      <div class="hero__frame scanlines">
        <Image
          class="hero__photo"
          src={profile}
          alt={`${site.name}, smiling, in a dark jacket and light shirt`}
          width={450}
          height={450}
          loading="eager"
          densities={[1]}
        />
      </div>
      <p class="hero__plate">
        <span class="hero__blip" aria-hidden="true"></span>
        Open to roles
      </p>
    </div>

    <div class="hero__text">
      <h1 class="hero__name">{site.name}</h1>
      <p class="hero__title">
        {site.titleLine}<span class="hero__caret" aria-hidden="true"></span>
      </p>
      <p class="hero__positioning">{site.positioningLine}</p>
      <p class="hero__open">{site.openToLine}</p>

      <div class="cluster hero__actions">
        <a class="btn btn--primary" href={site.linkedin} target="_blank" rel="noopener" data-goatcounter-click="linkedin">
          LinkedIn
        </a>
        <a class="btn btn--ghost" href={site.resume} target="_blank" rel="noopener" data-goatcounter-click="resume-download">
          Resume
        </a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`} data-goatcounter-click="email">Email</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--s-6) var(--s-7);
    background: var(--surface-sunken);
    border-block-end: 3px solid var(--ink);
  }

  /* Pixel graph paper behind everything. */
  .hero__bg {
    position: absolute;
    inset: 0;
    /* z-index 0 makes this a stacking context. Without it the absolutely
       positioned .hero__px children paint after the hero's inline text
       (CSS 2.1 painting order step 8 vs 7) and land on top of the copy. */
    z-index: 0;
    pointer-events: none;
    background-image: linear-gradient(var(--rule) 2px, transparent 2px),
      linear-gradient(90deg, var(--rule) 2px, transparent 2px);
    background-size: 44px 44px;
    opacity: 0.55;
  }

  /* Loose pixels drifting in the background. */
  .hero__px {
    position: absolute;
    inline-size: 16px;
    block-size: 16px;
    border: 2px solid var(--ink);
    animation: float 9s ease-in-out infinite;
  }

  /* Hidden on narrow screens, where the copy uses the full width. */
  .hero__px {
    display: none;
  }

  .hero__px--1 {
    top: 12%;
    left: 2%;
    background: var(--c-cyan);
  }
  .hero__px--2 {
    bottom: 14%;
    left: 3%;
    background: var(--c-gold);
    animation-delay: -2.5s;
  }
  .hero__px--3 {
    top: 14%;
    right: 3%;
    background: var(--c-lime);
    animation-delay: -5s;
  }
  .hero__px--4 {
    bottom: 18%;
    right: 6%;
    background: var(--c-violet);
    animation-delay: -7s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  /* ---- Character card ---- */

  .hero__card {
    inline-size: clamp(116px, 30vw, 164px);
  }

  .hero__frame {
    border: 3px solid var(--ink);
    background: var(--c-cyan);
    box-shadow: var(--drop-lg) var(--accent);
    animation: bob 6s ease-in-out infinite;
  }

  .hero__photo {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  .hero__plate {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
    font-family: var(--font-pixel), monospace;
    font-size: var(--pixel-xs);
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .hero__blip {
    inline-size: 9px;
    block-size: 9px;
    flex: none;
    background: var(--c-lime);
    border: 2px solid var(--ink);
    animation: blink 1.6s steps(1, end) infinite;
  }

  @keyframes blink {
    0%,
    60% {
      opacity: 1;
    }
    61%,
    100% {
      opacity: 0.25;
    }
  }

  /* ---- Pitch ---- */

  .hero__name {
    font-family: var(--font-pixel), monospace;
    font-weight: 400;
    font-size: var(--pixel-hero);
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: uppercase;
    /* Hard pixel shadow, the classic arcade title treatment. */
    text-shadow: var(--title-shadow, 3px) var(--title-shadow, 3px) 0 var(--accent);
    margin-bottom: var(--s-4);
  }

  .hero__title {
    display: flex;
    align-items: center;
    gap: 2px;
    font-family: var(--font-pixel), monospace;
    font-size: var(--pixel-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-violet);
    margin-bottom: var(--s-5);
  }

  .hero__caret {
    display: inline-block;
    inline-size: 8px;
    block-size: 1em;
    margin-inline-start: 4px;
    background: currentColor;
    animation: blink 1.1s steps(1, end) infinite;
  }

  .hero__positioning {
    max-width: 24ch;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--s-4);
  }

  .hero__open {
    max-width: 48ch;
    font-size: var(--text-base);
    color: var(--ink-muted);
    margin-bottom: var(--s-5);
  }

  .hero__actions {
    gap: var(--s-4) var(--s-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__frame,
    .hero__px,
    .hero__blip,
    .hero__caret {
      animation: none;
    }
  }

  /* Two columns once there is room: pitch left, card right. */
  @media (min-width: 56rem) {
    .hero {
      padding-block: var(--s-8) var(--s-9);
      --title-shadow: 4px;
    }

    .hero__px {
      display: block;
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'text card';
      align-items: center;
      gap: var(--s-8);
      justify-items: stretch;
    }

    .hero__text {
      grid-area: text;
    }

    .hero__card {
      grid-area: card;
      inline-size: clamp(190px, 20vw, 250px);
    }

    .hero__positioning {
      max-width: 20ch;
    }
  }
</style>
