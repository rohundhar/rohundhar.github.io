---
/**
 * Arcade score tiles. Every number comes from the one-page resume — see
 * src/data/site.ts. Do not add one that isn't on the resume.
 */
import { stats } from '../data/site';
---

<ul class="stats">
  {
    stats.map((stat) => (
      <li class="stat scanlines" style={`--tile: var(--c-${stat.color}); --tile-wash: var(--c-${stat.color}-wash)`}>
        <p class="stat__value">
          <span class="stat__number">{stat.value}</span>
          <span class="stat__unit">{stat.unit}</span>
        </p>
        <p class="stat__label">{stat.label}</p>
      </li>
    ))
  }
</ul>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stat {
    padding: var(--s-4);
    background: var(--tile-wash);
    border: 2px solid var(--ink);
    box-shadow: var(--drop) var(--tile);
  }

  .stat__value {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-pixel), monospace;
    color: var(--tile);
    line-height: 1.2;
  }

  .stat__number {
    font-size: var(--pixel-lg);
  }

  .stat__unit {
    font-size: var(--pixel-xs);
  }

  .stat__label {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
  }

  @media (min-width: 52rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
