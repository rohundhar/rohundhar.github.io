---
/**
 * Site header. The link order is fixed by docs/designdoc.md:
 * Projects · About · Now · Resume · LinkedIn
 *
 * On narrow screens the header becomes two rows (brand + toggle, then the
 * links) so all five stay visible — nothing is hidden behind a menu.
 */
import { nav, site } from '../data/site';
import Monogram from './Monogram.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

/** Treat /projects/anything/ as "Projects" being the current section. */
function isCurrent(href: string) {
  if (href.startsWith('http') || href.endsWith('.pdf')) return false;
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner wrap">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <Monogram size={34} />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['site-nav__link', { 'is-current': isCurrent(item.href) }]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
                data-goatcounter-click={item.event}
              >
                {item.label}
                {item.external && (
                  <svg
                    class="site-nav__ext"
                    viewBox="0 0 12 12"
                    width="9"
                    height="9"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  >
                    <path d="M4 2h6v6M10 2 3 9" />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 3px solid var(--ink);
  }

  /* Browsers without backdrop-filter get a solid bar instead of translucency. */
  @supports not (backdrop-filter: blur(10px)) {
    .site-header {
      background: var(--paper);
    }
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'brand nav toggle';
    align-items: center;
    gap: var(--s-4);
    min-block-size: 60px;
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    text-decoration: none;
    border-radius: var(--r-md);
  }

  .site-nav {
    grid-area: nav;
    display: flex;
    justify-content: flex-end;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--s-3), 1.6vw, var(--s-5));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding-block: var(--s-2);
    font-family: var(--font-pixel), monospace;
    font-size: var(--pixel-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--r-sm);
    transition: color var(--t-fast) var(--ease);
  }

  .site-nav__link:hover {
    color: var(--ink);
  }

  .site-nav__link.is-current {
    color: var(--ink);
  }

  /* Current-section marker that does not rely on colour alone. */
  .site-nav__link.is-current::before {
    content: '';
    inline-size: 7px;
    block-size: 7px;
    margin-inline-end: 3px;
    background: var(--accent);
  }

  .site-nav__ext {
    opacity: 0.55;
  }

  @media (max-width: 36rem) {
    .site-header__inner {
      /* 1fr on the brand column absorbs the slack so the toggle sits hard
         right; `auto auto` let the spanning nav row inflate both tracks. */
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand toggle'
        'nav nav';
      gap: var(--s-2) var(--s-4);
      padding-block: var(--s-3);
      min-block-size: 0;
    }

    .site-nav {
      justify-content: flex-start;
    }

    .site-nav__list {
      flex-wrap: wrap;
      gap: var(--s-2) var(--s-3);
    }

    /* The pixel face is wide; the arrows are what tip the row over 390px. */
    .site-nav__ext {
      display: none;
    }

    .site-nav__link {
      padding-block: var(--s-1);
    }
  }
</style>
